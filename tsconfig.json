{
  "compilerOptions": {
    "types": [
      "vite/client"
    ],
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "./dist",
    "allowJs": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*",
    "routes/**/*",
    "server.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}