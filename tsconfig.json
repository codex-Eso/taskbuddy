{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "./dist",
    "allowJs": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*",
    "routes/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}